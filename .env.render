# ⚠️ COPIER CE FICHIER DANS RENDER
# Ce fichier montre les variables à configurer dans Render

# Flask Configuration
SECRET_KEY=votre_cle_secrete_long_et_aleatoire_ici
DEBUG=False
DATABASE_URL=sqlite:///unissons.db

# Verification Mode (0=Production/envoie réel, 1=Dev/logs seulement)
VERIF_DEV_MODE=0

# SMTP Configuration (SendGrid)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.votre_cle_api_sendgrid_ici
SMTP_FROM="Unissons la Main <noreply@unissonslamain.org>"

# Twilio Configuration (WhatsApp)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=votre_token_auth_twilio_ici
TWILIO_WHATSAPP_FROM=whatsapp:+1415xxxxxxx

# Notes Render:
# - PORT est défini automatiquement par Render (ne pas mettre ici)
# - DATABASE_URL sera autogénéré si vous utilisez PostgreSQL
# - Les variables ci-dessus doivent être ajoutées manuellement dans Render Dashboard
