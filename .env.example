# Flask Configuration
SECRET_KEY=your_secret_key_here_change_in_production
DEBUG=True
DATABASE_URL=sqlite:///unissons.db

# Verification Mode
# Set to '1' for development (console/file logging), '0' for production
VERIF_DEV_MODE=1

# SMTP Configuration (for email verification codes)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key_here
SMTP_FROM="Unissons la Main <noreply@unissonslamain.org>"

# Twilio Configuration (for WhatsApp verification)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+1415xxxxxxx
